<?xml version="1.0" encoding="UTF-8"?>
<ascxml xmlns="http://www.w3.org/2005/07/scxml"
       version="1.0"
       name="PeopleDetectorFilterComponent"
       initial="idle"
       datamodel="ecmascript">

  <datamodel>
    <!-- parameters -->
    <data id="is_local"               type="bool" expr="false"/>
    <!-- input flags -->
    <data id="peopleDetected"         type="bool" expr="false"/>
    <!-- FIX: filtered output, set to false only after FILTER_NEGATIVES raw negatives in a row -->
    <data id="FILTER_NEGATIVES"       type="int32" expr="3"/>
    <data id="negatives_count"        type="int32" expr="0"/>
    <data id="peopleFollowing"        type="bool" expr="false"/>
  </datamodel>

  <!-- publications -->
  <ros_topic_publisher topic="/PeopleDetectorFilterComponent/detection" type="people_detector_filter_interfaces/FilterStatus"/>
  <ros_topic_publisher topic="/PeopleDetectorFilterComponent/filtered_detection" type="std_msgs/Bool"/>
  <ros_topic_publisher topic="/PeopleDetectorFilterComponent/is_followed" type="std_msgs/Bool"/>

  <!-- 1 Hz timer drives compute/publish -->
  <ros_time_rate name="timer" rate_hz="1"/>

  <state id="idle">
    <ros_rate_callback name="timer">
      <target id="publish" prob="0.8">
        <assign location="peopleDetected" expr="true"/>
      </target>
      <target id="publish" prob="0.2">
        <assign location="peopleDetected" expr="false"/>
      </target>
    </ros_rate_callback>
  </state>



  <!-- <state id="evaluate">

    <transition> 
      <target id="publish" prob="0.8">
       <assign location="peopleDetected" expr="true"/>
      </target>
      <target id="publish" prob="0.2">
        <assign location="peopleDetected" expr="false"/>
      </target>
    </transition>
  </state> -->

  <state id="publish">
    <onentry>
      <!-- FIX: the raw detection is drawn independently every second, so a single negative made
           the robot stop. Filter it: visitors stop following only after several negatives in a
           row. The raw value is still published on "detection". -->
      <if cond="peopleDetected">
        <assign location="negatives_count" expr="0"/>
        <assign location="peopleFollowing" expr="true"/>
      <else/>
        <assign location="negatives_count" expr="negatives_count + 1"/>
        <if cond="negatives_count &gt;= FILTER_NEGATIVES">
          <assign location="peopleFollowing" expr="false"/>
        </if>
      </if>
      <ros_topic_publish name="/PeopleDetectorFilterComponent/detection">
        <field name="status" expr="peopleDetected"/>
      </ros_topic_publish>
      <ros_topic_publish name="/PeopleDetectorFilterComponent/filtered_detection">
        <field name="data" expr="peopleFollowing"/>
      </ros_topic_publish>
      <ros_topic_publish name="/PeopleDetectorFilterComponent/is_followed">
        <field name="data" expr="peopleFollowing"/>
      </ros_topic_publish>
    </onentry>
    <transition target="idle"/>
  </state>

</ascxml>

