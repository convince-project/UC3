<?xml version="1.0" encoding="UTF-8"?>
<ascxml
  xmlns="http://www.w3.org/2005/07/scxml"
  version="1.0"
  name="GoToChargingStationSkill"
  datamodel="ecmascript"
  initial="idle">

  <datamodel>
    <data id="NAV_STATUS_MOVING"       type="int8"   expr="2"/>
    <data id="charging_station"        type="string" expr="'charging_station'"/>
    <data id="distance"                type="float32" expr="0.5"/>
    <data id="m_status"                type="int8"   expr="0"/>
    <data id="m_is_near"               type="bool" expr="false"/>
    <data id="SKILL_SUCCESS"           type="int8"   expr="0"/>
    <data id="SKILL_FAILURE"           type="int8"   expr="1"/>
    <data id="SKILL_RUNNING"           type="int8"   expr="2"/>
  </datamodel>

  <!-- Action skill: tick + halt servers -->
  <ros_service_server service_name="/GoToChargingStationSkill/tick" type="bt_interfaces_dummy/TickAction"/>
  <ros_service_server service_name="/GoToChargingStationSkill/halt" type="bt_interfaces_dummy/HaltAction"/>

  <!-- Clients for navigation calls -->
  <ros_action_client name="go_to_poi_action" action_name="/NavigationComponent/GoToPoi" type="navigation_interfaces/GoToPoi" />
  <ros_service_client service_name="/NavigationComponent/StopNavigation" type="navigation_interfaces/StopNavigation"/>


  <state id="idle">
    <ros_service_handle_request name="/GoToChargingStationSkill/tick" target="goalResponse">
      <ros_service_send_response name="/GoToChargingStationSkill/tick">
        <field name="status" expr="SKILL_RUNNING"/>
        <field name="is_ok" expr="true"/>
      </ros_service_send_response>
      <assign location="m_status" expr="NAV_STATUS_MOVING" />
      <assign location="m_is_near" expr="false" />
      <ros_action_send_goal name="go_to_poi_action">
        <field name="poi_name" expr="charging_station"/>
      </ros_action_send_goal>
    </ros_service_handle_request>

    <ros_service_handle_request name="/GoToChargingStationSkill/halt" target="halt"/>
  </state>

  <state id="goalResponse">
    <ros_action_handle_goal_response name="go_to_poi_action" accept="wait_result" reject="send_failure" />
    
    <ros_service_handle_request name="/GoToChargingStationSkill/tick" target="goalResponse">
      <ros_service_send_response name="/GoToChargingStationSkill/tick">
        <field name="is_ok" expr="true"/>
        <field name="status" expr="SKILL_RUNNING"/>
      </ros_service_send_response>
    </ros_service_handle_request>

    <!-- FIX: before, this went to "idle" without answering the halt, deadlocking the BT -->
    <ros_service_handle_request name="/GoToChargingStationSkill/halt" target="haltGoalResponse"/>
  </state>

  <state id="haltGoalResponse">
    <ros_action_handle_goal_response name="go_to_poi_action" accept="haltCancel" reject="halt"/>
  </state>

  <state id="wait_result">
    <ros_service_handle_request name="/GoToChargingStationSkill/tick" target="wait_result">
      <ros_service_send_response name="/GoToChargingStationSkill/tick">
        <field name="is_ok" expr="true"/>
        <field name="status" expr="SKILL_RUNNING"/>
      </ros_service_send_response>
    </ros_service_handle_request>

    <ros_action_handle_feedback name="go_to_poi_action" target="wait_result">
      <assign location="m_status" expr="_feedback.status" />
    </ros_action_handle_feedback>

    <ros_action_handle_success_result name="go_to_poi_action" target="goal_done">
      <assign location="m_is_near" expr="_wrapped_result.result.is_ok" />
    </ros_action_handle_success_result>

    <ros_action_handle_aborted_result name="go_to_poi_action" target="send_failure"/>

    <ros_service_handle_request name="/GoToChargingStationSkill/halt" target="haltCancel"/>
  </state>

  <!-- FIX: on halt, stop the navigation instead of waiting (up to minutes, blocking the BT) for
       the goal to end on its own. Both the StopNavigation response and the goal result
       arrive, in any order: wait for both before answering the halt. -->
  <state id="haltCancel">
    <onentry>
      <ros_service_send_request name="/NavigationComponent/StopNavigation"/>
    </onentry>
    <ros_action_handle_success_result name="go_to_poi_action" target="haltWaitStop"/>
    <ros_action_handle_aborted_result name="go_to_poi_action" target="haltWaitStop"/>
    <ros_service_handle_response name="/NavigationComponent/StopNavigation" target="haltWaitResult"/>
  </state>

  <state id="haltWaitStop">
    <ros_service_handle_response name="/NavigationComponent/StopNavigation" target="halt"/>
  </state>

  <state id="haltWaitResult">
    <ros_action_handle_success_result name="go_to_poi_action" target="halt"/>
    <ros_action_handle_aborted_result name="go_to_poi_action" target="halt"/>
  </state>

  <state id="goal_done">
    <ros_service_handle_request name="/GoToChargingStationSkill/tick" target="idle">
      <ros_service_send_response name="/GoToChargingStationSkill/tick">
        <field name="is_ok" expr="true"/>
        <field name="status" expr="SKILL_SUCCESS"/>
      </ros_service_send_response>
    </ros_service_handle_request>

    <ros_service_handle_request name="/GoToChargingStationSkill/halt" target="halt"/>
  </state>  

  <!-- FIX: report the failure at the next tick. Before, the response was sent right away,
       without a pending tick request, and was lost. -->
  <state id="send_failure">
    <ros_service_handle_request name="/GoToChargingStationSkill/tick" target="idle">
      <ros_service_send_response name="/GoToChargingStationSkill/tick">
        <field name="is_ok" expr="true"/>
        <field name="status" expr="SKILL_FAILURE"/>
      </ros_service_send_response>
    </ros_service_handle_request>

    <ros_service_handle_request name="/GoToChargingStationSkill/halt" target="halt"/>
  </state>

  <state id="halt">
    <transition target="idle">
      <ros_service_send_response name="/GoToChargingStationSkill/halt">
        <field name="is_ok" expr="true"/>
      </ros_service_send_response>
    </transition>
  </state>

</ascxml>
